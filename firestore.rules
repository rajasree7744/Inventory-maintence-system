rules_version = '2';

/**
 * SmartLink Computer Systems - Master Administrator Rules
 * Enforces strict role-based access for admin@gmail.com
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is the authorized Master Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }

    // Products: Publicly readable. Admin only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    // Feedback: Publicly creatable. Only Master Admin can read the ledger.
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Sales: Master Admin only.
    match /sales/{saleId} {
      allow read, write: if isAdmin(); 
    }

    // Alerts: Master Admin only.
    match /alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Admins Collection: Master Admin only.
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    
    // Carts: Users manage their own cart.
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}